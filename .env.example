# LLM API配置（支持 OpenAI SDK 格式的任意 LLM）
# 推荐使用阿里百炼平台Qwen-plus模型：https://bailian.console.aliyun.com/
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# LLM 联网查询兜底配置（用于 Step2 真实人设验证，默认复用阿里百炼兼容模式）
# 未配置时默认复用 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_NAME。
LLM_WEB_SEARCH_API_KEY=
LLM_WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_WEB_SEARCH_MODEL=qwen-plus
LLM_WEB_SEARCH_STRATEGY=max
LLM_WEB_SEARCH_VALIDATE_LINKS=true
REAL_ENTITY_BATCH_SIZE=30

# Flask 运行模式
FLASK_DEBUG=False

# ===== Zep 后端配置 =====
# 后端选择: 'cloud' 使用 Zep Cloud | 'graphiti' 使用本地 Neo4j
ZEP_BACKEND=cloud

# Zep Cloud 配置（ZEP_BACKEND=cloud 时必需）
# 每月免费额度即可支撑使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Graphiti / Neo4j 本地配置（ZEP_BACKEND=graphiti 时必需）=====
# 启动 Neo4j: docker-compose -f docker-compose.local.yml up -d
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Graphiti 需要 OpenAI 兼容的 LLM 用于实体抽取
# OPENAI_API_KEY/OPENAI_BASE_URL 会自动从 LLM_API_KEY/LLM_BASE_URL 映射
# 如需单独配置 Graphiti 使用的 LLM，可显式设置：
# OPENAI_API_KEY=your_openai_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Graphiti 默认模型（推荐显式配置，避免使用 OpenAI 默认模型名导致不兼容）
# - DashScope chat 推荐：qwen-plus（稳定/成本均衡）；更高质量可用 qwen-max 或 qwen3-max（以百炼控制台可用模型为准）
# - DashScope embedding 推荐：text-embedding-v4
GRAPHITI_LLM_MODEL=qwen-plus
GRAPHITI_EMBEDDING_MODEL=text-embedding-v4

# 搜索重排序配置（可选）
# 非标准 OpenAI API（如 DashScope）会自动降级为 RRF 重排序
# 如确认你的 API 支持 logprobs，可强制使用 cross_encoder：
# GRAPHITI_FORCE_CROSS_ENCODER=true

# ===== 博查 Web Search API 配置（启用关键词联网搜索时必需）=====
# 后端持有 API Key，前端不得配置 VITE_BOCHA_*。
BOCHA_API_KEY=your_bocha_api_key_here
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_WEB_SEARCH_ENDPOINT=/web-search
BOCHA_WEB_SEARCH_TIMEOUT=30
BOCHA_WEB_SEARCH_MAX_RESULTS=8
BOCHA_WEB_SEARCH_FRESHNESS=twoMonths
BOCHA_WEB_SEARCH_RECENT_DAYS=60
BOCHA_VALIDATE_LINKS=true
BOCHA_LINK_CHECK_TIMEOUT=5
BOCHA_LINK_CHECK_MAX_BYTES=16384

# ===== 加速 LLM 配置（可选，仅双平台并行模拟中 Reddit 平台使用）=====
# 如果不使用加速配置，请不要在 .env 中保留下面三个配置项。
LLM_BOOST_API_KEY=your_boost_api_key_here
LLM_BOOST_BASE_URL=https://api.deepseek.com/v1
LLM_BOOST_MODEL_NAME=deepseek-chat
