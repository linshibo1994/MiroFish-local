  # LLM（OpenAI-compatible；用百炼就用 compatible-mode）
  LLM_API_KEY=
  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
  LLM_MODEL_NAME=qwen3-max

  # LLM 联网查询兜底配置（用于 Step2 真实人设验证，默认复用阿里百炼兼容模式）
  LLM_WEB_SEARCH_API_KEY=
  LLM_WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
  LLM_WEB_SEARCH_MODEL=qwen3-max
  LLM_WEB_SEARCH_STRATEGY=max
  LLM_WEB_SEARCH_VALIDATE_LINKS=true
  REAL_ENTITY_BATCH_SIZE=30

  # 联网搜索能力选择：默认走阿里百炼 websearch；需要博查时再显式开启。
  USE_BOCHA_WEB_SEARCH=false
  WEB_SEARCH_PROVIDER=bailian

  # Graphiti 图谱写回用：百炼兼容模式下 qwen-plus 稳定且成本较均衡；
  # 更高质量可改为 qwen-max / qwen3-max（以百炼控制台可用模型为准）。
  GRAPHITI_LLM_MODEL=qwen-plus
  GRAPHITI_EMBEDDING_MODEL=text-embedding-v4

  # ===== 加速 LLM 配置（可选）=====
  # 用于图谱构建、Agent人设生成、模拟配置和报告生成等高并发 LLM 环节。
  # 如果不使用加速配置，请不要在 .env 中保留下面三个配置项。
  # LLM_BOOST_API_KEY：加速 LLM 服务的 API Key；配置为空或缺失时自动回退到默认 LLM。
  LLM_BOOST_API_KEY=
  # LLM_BOOST_BASE_URL：加速 LLM 的 OpenAI 兼容接口地址，例如 DashScope compatible-mode/v1。
  LLM_BOOST_BASE_URL=https://api.deepseek.com/v1
  # LLM_BOOST_MODEL_NAME：加速 LLM 的模型名称，用于并发生成、抽取和报告写作。
  LLM_BOOST_MODEL_NAME=deepseek-chat

  # ===== 并发加速配置（可选）=====
  # Graphiti 本地写入建议先用批量灌入，再逐步上调并发。
  # GRAPH_BUILD_BATCH_SIZE：图谱构建时每批提交的文本块数量；越大调度次数越少，但单批失败重试成本更高。
  GRAPH_BUILD_BATCH_SIZE=3
  # GRAPH_BUILD_CONCURRENCY：图谱构建批次并发数；仅 Graphiti 本地后端并发写入，云端 Zep 会保守串行提交。
  GRAPH_BUILD_CONCURRENCY=2
  # GRAPH_BUILD_BATCH_DELAY_SECONDS：图谱批次提交后的节流等待秒数；遇到 LLM/Neo4j 限流或写入压力时可调大。
  GRAPH_BUILD_BATCH_DELAY_SECONDS=0
  # GRAPHITI_OPERATION_TIMEOUT_SECONDS：Graphiti 单次异步操作最长等待秒数，避免图谱写入或查询长时间卡死。
  GRAPHITI_OPERATION_TIMEOUT_SECONDS=900
  # GRAPHITI_RATE_LIMIT_MAX_RETRIES：Graphiti 调用 LLM/Embedding 触发限流时的最大重试次数。
  GRAPHITI_RATE_LIMIT_MAX_RETRIES=3
  # GRAPHITI_RATE_LIMIT_RETRY_SECONDS：Graphiti 限流重试的基础等待秒数；多次重试会按次数递增等待。
  GRAPHITI_RATE_LIMIT_RETRY_SECONDS=20
  # GRAPH_MEMORY_STOP_TIMEOUT_SECONDS：停止或重跑模拟时等待图谱记忆后台线程收尾的秒数，避免旧任务阻塞新流程。
  GRAPH_MEMORY_STOP_TIMEOUT_SECONDS=3
  # REAL_ENTITY_RESOLVE_CONCURRENCY：真实实体识别、去重和关联校验的并发数。
  REAL_ENTITY_RESOLVE_CONCURRENCY=3
  # PROFILE_GENERATION_CONCURRENCY：Agent 人设生成的并发数，主要影响 Step2 环境搭建速度。
  PROFILE_GENERATION_CONCURRENCY=5
  # SIMULATION_CONFIG_CONCURRENCY：Agent 活动配置和模拟配置生成的并发数，主要影响 Step2 准备阶段速度。
  SIMULATION_CONFIG_CONCURRENCY=3
  # REPORT_TOOL_CONCURRENCY：Step4 报告生成时检索/图谱查询等工具调用的并发数。
  REPORT_TOOL_CONCURRENCY=3
  # REPORT_SECTION_CONCURRENCY：Step4 报告章节并发写作数量；过高可能触发 LLM 限流或造成章节风格不稳。
  REPORT_SECTION_CONCURRENCY=2

  # 本地图谱后端
  ZEP_BACKEND=graphiti
  NEO4J_URI=bolt://localhost:7687
  NEO4J_USER=neo4j
  NEO4J_PASSWORD=password

  # 博查 Web Search API（USE_BOCHA_WEB_SEARCH=true 时必需）
  BOCHA_API_KEY=
  BOCHA_BASE_URL=https://api.bochaai.com/v1
  BOCHA_WEB_SEARCH_ENDPOINT=/web-search
  BOCHA_WEB_SEARCH_TIMEOUT=30
  BOCHA_WEB_SEARCH_MAX_RESULTS=8
  BOCHA_WEB_SEARCH_FRESHNESS=twoMonths
  BOCHA_WEB_SEARCH_RECENT_DAYS=60
  BOCHA_VALIDATE_LINKS=true
  BOCHA_LINK_CHECK_TIMEOUT=5
  BOCHA_LINK_CHECK_MAX_BYTES=16384
