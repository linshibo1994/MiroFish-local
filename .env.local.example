  # LLM（OpenAI-compatible；用百炼就用 compatible-mode）
  LLM_API_KEY=
  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
  LLM_MODEL_NAME=qwen3-max

  # LLM 联网查询兜底配置（用于 Step2 真实人设验证，默认复用阿里百炼兼容模式）
  LLM_WEB_SEARCH_API_KEY=
  LLM_WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
  LLM_WEB_SEARCH_MODEL=qwen3-max
  LLM_WEB_SEARCH_STRATEGY=max
  LLM_WEB_SEARCH_VALIDATE_LINKS=true
  REAL_ENTITY_BATCH_SIZE=30

  GRAPHITI_LLM_MODEL=qwen3-max
  GRAPHITI_EMBEDDING_MODEL=text-embedding-v4

  # 本地图谱后端
  ZEP_BACKEND=graphiti
  NEO4J_URI=bolt://localhost:7687
  NEO4J_USER=neo4j
  NEO4J_PASSWORD=password

  # 博查 Web Search API（启用关键词联网搜索时必需）
  BOCHA_API_KEY=
  BOCHA_BASE_URL=https://api.bochaai.com/v1
  BOCHA_WEB_SEARCH_ENDPOINT=/web-search
  BOCHA_WEB_SEARCH_TIMEOUT=30
  BOCHA_WEB_SEARCH_MAX_RESULTS=8
  BOCHA_WEB_SEARCH_FRESHNESS=twoMonths
  BOCHA_WEB_SEARCH_RECENT_DAYS=60
  BOCHA_VALIDATE_LINKS=true
  BOCHA_LINK_CHECK_TIMEOUT=5
  BOCHA_LINK_CHECK_MAX_BYTES=16384
